# ─────────────────────────────────────────────────────────────────────────────
# Studio Kit — variables de entorno
#
# En Railway (botón "Deploy") todo esto se rellena solo: NO necesitas este
# archivo. Sirve para desarrollo local o para desplegar en otro sitio.
# Copia a .env y cambia lo que necesites.
#
# Lo del estudio (nombre, logo, colores, emails, Stripe…) NO va aquí: se
# configura en el panel, en el asistente de bienvenida.
# ─────────────────────────────────────────────────────────────────────────────

# ── Imprescindibles en producción ──
# Clave secreta larga y aleatoria:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Primera cuenta del panel (se crea al arrancar si no existe ninguna)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# postgres://usuario:contraseña@servidor:5432/basededatos  (vacío = SQLite local)
DATABASE_URL=
# redis://…  (vacío = sin recordatorios ni tareas nocturnas)
REDIS_URL=

# ── Direcciones públicas ──
# Donde vive el API + panel, y la web de reservas (sin barra final)
API_URL=http://localhost:8000
WEB_URL=http://localhost:4321

# ── Opcionales ──
DEBUG=1
STUDIO_NAME=Mi Estudio
SEED_DEMO=1                       # 1 = carga clases de ejemplo si la BD está vacía
STUDIO_TIMEZONE=Europe/Madrid
BOOKING_CANCEL_MIN_HOURS=8        # horas mínimas para que una clienta cancele
JWT_ACCESS_DAYS=30
JWT_REFRESH_DAYS=90

# Email por entorno (alternativa al panel). Ejemplo Gmail con contraseña de aplicación:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tuestudio@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# DEFAULT_FROM_EMAIL=tuestudio@gmail.com

# Stripe por entorno (alternativa al panel, que además crea el webhook solo)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# (El acceso con Google se activa desde el panel → Ajustes → Acceso con Google)

# Monitorización (avanzado)
# SENTRY_DSN=
# LOKI_URL=
# LOKI_USER=
# LOKI_API_KEY=

# WhatsApp automático con servidor whatsmeow propio (avanzado)
# WHATSAPP_OUTBOX_URL=
# WHATSAPP_BOT_ID=
