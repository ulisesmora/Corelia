# ─────────────────────────────────────────────────────────────────────────────
# Corelia — variables de entorno
#
# En Railway (botón "Deploy") todo esto se rellena solo: NO necesitas este
# archivo. Sirve para desarrollo local o para desplegar en otro sitio.
# Copia a .env y cambia lo que necesites.
#
# Lo del estudio (nombre, logo, colores, emails, Stripe…) NO va aquí: se
# configura en el panel, en el asistente de bienvenida.
# ─────────────────────────────────────────────────────────────────────────────

# ── Imprescindibles en producción ──
# Clave secreta larga y aleatoria:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Primera cuenta del panel (se crea al arrancar si no existe ninguna)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# postgres://usuario:contraseña@servidor:5432/basededatos  (vacío = SQLite local)
DATABASE_URL=
# redis://…  (vacío = sin recordatorios ni tareas nocturnas)
REDIS_URL=

# ── Direcciones públicas ──
# Donde vive el API + panel, y la web de reservas (sin barra final)
API_URL=http://localhost:8000
WEB_URL=http://localhost:4321

# ── Opcionales ──
DEBUG=1
STUDIO_NAME=Mi Estudio
SEED_DEMO=1                       # 1 = carga clases de ejemplo si la BD está vacía
STUDIO_TIMEZONE=Europe/Madrid
BOOKING_CANCEL_MIN_HOURS=8        # horas mínimas para que una clienta cancele
JWT_ACCESS_DAYS=30
JWT_REFRESH_DAYS=90

# Email por entorno (alternativa al panel). Ejemplo Gmail con contraseña de aplicación:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tuestudio@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# DEFAULT_FROM_EMAIL=tuestudio@gmail.com

# Stripe por entorno (alternativa al panel, que además crea el webhook solo)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# «Conectar pagos» (Stripe Connect, opcional; para quien instala Corelia para otros
# estudios). Sin estas variables el panel pide las claves como siempre.
# Guía paso a paso: docs/STRIPE_CONNECT.md
# STRIPE_CONNECT_PLATFORM_KEY=          # sk_test_… / sk_live_… de tu plataforma
# STRIPE_CONNECT_PUBLISHABLE_KEY=       # pk_… del mismo modo
# STRIPE_CONNECT_WEBHOOK_SECRET=        # whsec_… del endpoint Connect (…/api/v1/webhooks/connect/)
# STRIPE_CONNECT_BOOKING_PMC=           # opcional: pmc_… sin métodos asíncronos, para reservas
# STRIPE_CONNECT_COUNTRIES=ES,PT,FR,DE,IT,NL,BE,AT,LU,FI,GR,IE,GB,CH,LI,US,CA,MX,BR
# STRIPE_CONNECT_AVAILABILITY_CHECK=    # opcional: ruta a f(site_config) -> bool
# PANEL_URL=http://localhost:5173       # dónde está el panel si no lo sirve el API (en desarrollo, Vite):
#                                       # se vuelve ahí desde Stripe y la web deja que la vista previa
#                                       # de «Mi web» la enseñe en un marco. Por defecto, la del API.

# (El acceso con Google se activa desde el panel → Ajustes → Acceso con Google)

# Seguridad (todo opcional; explicado en docs/SEGURIDAD.md)
# Captcha Cloudflare Turnstile (gratis): dash.cloudflare.com → Turnstile → Add widget.
# Vacías = sin captcha. Claves de PRUEBA para local (siempre pasan):
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# LOGIN_LOCKOUT_ATTEMPTS=5        # fallos seguidos que bloquean un email…
# LOGIN_LOCKOUT_MINUTES=15        # …durante estos minutos
# LOGIN_CAPTCHA_AFTER=3           # fallos tras los que se pide el captcha al entrar
# THROTTLE_LOGIN=10/m             # límites por IP/email: THROTTLE_<NOMBRE>=número/periodo
# TRUSTED_PROXY_CIDRS=            # proxies propios con IP pública delante del API
# SECURE_HSTS_INCLUDE_SUBDOMAINS=0

# Monitorización (avanzado)
# SENTRY_DSN=
# LOKI_URL=
# LOKI_USER=
# LOKI_API_KEY=

# WhatsApp automático con servidor whatsmeow propio (avanzado)
# WHATSAPP_OUTBOX_URL=
# WHATSAPP_BOT_ID=
