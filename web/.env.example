# URL del backend (Django). En el navegador la web llama a /api/* y este
# servidor lo reenvía aquí. Ej.: http://localhost:8000 o la URL privada de Railway.
API_URL=http://localhost:8000

# Dominio público por defecto (canonical, sitemap, Open Graph). Si el estudio
# pone su dominio en el panel (site_url de la config), manda ese sin redesplegar.
PUBLIC_SITE_URL=http://localhost:4321

# Vercel: no hace falta nada más; su build define VERCEL y astro.config.mjs
# usa el adaptador @astrojs/vercel. API_URL debe ser la URL pública https del API.

# Opcional: Microsoft Clarity (analítica). Vacío = sin analítica.
# PUBLIC_CLARITY_ID=

# Opcional: 1 = robots.txt bloquea la indexación (entornos de prueba).
# NOINDEX=1
