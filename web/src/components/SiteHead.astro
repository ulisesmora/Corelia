---
/**
 * SiteHead — marca del estudio en el <head>. Va en TODAS las páginas (directo
 * o a través de OptimizedHead).
 *
 * - Serializa la config del estudio en `window.__SITE__` (la leen los
 *   componentes React con useSite()/getSiteClient()).
 * - Variables CSS de marca: --brand-primary, --brand-secondary, --brand-dark,
 *   --brand-bg, --font-heading, --font-body (+ derivadas de contraste).
 * - Estilo visual e iconos: carga styles/presets.css (tokens de acabado por
 *   estilo) y asegura `data-style` / `data-icons` en <html> antes del primer
 *   pintado. Lo normal es que la página ya los traiga en su <html>
 *   (`htmlThemeAttrs(site)`); el script en línea es la red de seguridad.
 * - Carga las dos fuentes de Google Fonts de la config sin bloquear el pintado.
 * - Favicon, manifest (PWA), theme-color y nombre de la app al instalarla
 *   (los iconos los genera el backend: /api/v1/site-config/icon/…).
 * - Verificación de buscadores: <meta> de Google Search Console y Bing si el
 *   estudio ha pegado su código en el panel.
 * - Analítica y publicidad (GA4, Google Ads, píxel de Meta y Microsoft Clarity
 *   con PUBLIC_CLARITY_ID): SOLO con consentimiento (CookieConsent.astro +
 *   lib/tracking.ts). Sin ningún ID no se pinta nada: ni banner ni scripts.
 * - Vídeo de YouTube en la portada (Ajustes → Portada): categoría «Vídeos»
 *   del mismo banner; el iframe solo se carga con ese consentimiento (lib/hero.ts).
 */
import {
  ICON_URL, clarityProjectId, getSiteConfig, googleFontsHref, shortName, siteJsonForScript, themeCss,
} from '../lib/site';
import '../styles/presets.css';
import CookieConsent from './CookieConsent.astro';
import type { TrackingConfig } from '../lib/tracking';

interface Props {
  /**
   * Si true, la página no registra visitas (page_view) ni carga Clarity
   * (páginas legales, resultado del pago, enlaces con token). El banner de
   * cookies y las conversiones (track) siguen funcionando.
   */
  noAnalytics?: boolean;
}
const { noAnalytics = false } = Astro.props;

const site = await getSiteConfig();
const fontsHref = googleFontsHref(site);
const appName = shortName(site);

// Clarity: en tiempo de ejecución (process.env) o fijado en el build (import.meta.env)
const clarityId = clarityProjectId();

// IDs de analítica y publicidad (ya validados con su patrón en lib/site.ts)
const ads = site.google_ads_id;
const trk: TrackingConfig = {
  ...(site.ga4_measurement_id ? { ga4: site.ga4_measurement_id } : {}),
  ...(ads ? { ads } : {}),
  ...(ads && site.google_ads_purchase_label ? { adsPurchase: site.google_ads_purchase_label } : {}),
  ...(ads && site.google_ads_signup_label ? { adsSignup: site.google_ads_signup_label } : {}),
  ...(site.meta_pixel_id ? { pixel: site.meta_pixel_id } : {}),
  ...(clarityId ? { clarity: clarityId } : {}),
  ...(site.hero_mode === 'video' && site.hero_video_id ? { videos: true } : {}),
};
const hasTracking = !!(trk.ga4 || trk.ads || trk.pixel || trk.clarity || trk.videos);
if (noAnalytics) trk.lazy = true;
---
<script is:inline set:html={`window.__SITE__=${siteJsonForScript(site)};(function(d){d.setAttribute('data-style',${JSON.stringify(site.theme.style)});d.setAttribute('data-icons',${JSON.stringify(site.theme.icons)});})(document.documentElement);`} />
<style is:inline set:html={`${themeCss(site)}body{font-family:var(--font-body);}`} />

{/* Fuentes de la marca: preconnect + carga no bloqueante (print → all) */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={fontsHref} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={fontsHref} /></noscript>

{/* Iconos generados por el backend a partir del icono/logo del estudio */}
<link rel="icon" type="image/png" sizes="32x32" href={ICON_URL.favicon} />
{/* PWA: instalable + notificaciones push (manifest generado con la config) */}
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content={site.theme.primary} />
<link rel="apple-touch-icon" sizes="180x180" href={ICON_URL.appleTouch} />
{/* Nombre bajo el icono al instalar (máx. 12 caracteres para que no se corte):
    sin esto iOS usa el <title> de la página */}
<meta name="apple-mobile-web-app-title" content={appName} />
<meta name="application-name" content={appName} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />

{/* Verificación de la propiedad en Google Search Console y Bing Webmaster Tools */}
{site.google_site_verification && <meta name="google-site-verification" content={site.google_site_verification} />}
{site.bing_site_verification && <meta name="msvalidate.01" content={site.bing_site_verification} />}

{/* Consentimiento de cookies + GA4 / Google Ads / Meta / Clarity / vídeo de YouTube (solo si hay algo de eso) */}
{hasTracking && <CookieConsent config={trk} />}
