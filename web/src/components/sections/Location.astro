---
// "Cómo llegar": dirección en texto y mapa minimalista del estudio con los
// botones Google Maps / Apple Maps / Waze (StudioMap.astro: MapLibre +
// OpenFreeMap, sin cookies ni claves). Solo si hay dirección o coordenadas.
import StudioMap from './StudioMap.astro';
import { addressLine, type SiteConfig } from '../../lib/site';
import type { Lang } from '../../seo/site';

interface Props { site: SiteConfig; lang: Lang }
const { site, lang } = Astro.props;
const es = lang === 'es';
const address = addressLine(site);
const hasCoords = site.contact.latitude != null && site.contact.longitude != null;
---
{(address || hasCoords) && (
  <section class="loc" aria-labelledby="loc-title">
    <div class="loc-text">
      <h2 id="loc-title">{es ? 'Cómo llegar' : 'How to find us'}</h2>
      <address>
        <strong>{site.studio_name}</strong><br />
        {site.contact.address && <>{site.contact.address}<br /></>}
        {[site.contact.postal_code, site.contact.city].filter(Boolean).join(' ')}
      </address>
      {site.contact.area_served.length > 0 && (
        <p class="loc-areas">{es ? 'También atendemos: ' : 'We also serve: '}{site.contact.area_served.join(', ')}</p>
      )}
    </div>
    <StudioMap site={site} lang={lang} />
  </section>
)}

<style>
  /* Acabado con los tokens del estilo visual (styles/presets.css). */
  .loc { max-width: 1100px; margin: 0 auto; padding: 3rem 1.25rem 4rem; display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1fr); align-items: center; font-family: var(--font-body); color: var(--page-text); }
  @media (min-width: 820px) { .loc { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); } }
  .loc h2 { font-family: var(--font-heading); font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 0 0 1rem; letter-spacing: .02em; color: var(--heading-color); }
  .loc address { font-style: normal; line-height: 1.7; margin-bottom: 1rem; }
  .loc-areas { color: var(--text-muted); margin: 0 0 1rem; }
</style>
