---
// Opiniones del panel, solo en HTML. NO se marcan como Review/AggregateRating
// en JSON-LD: Google considera autopromoción las reseñas que publica el propio
// negocio. Si no hay opiniones ni enlace para dejar una en Google, la sección
// no se muestra.
import type { Lang } from '../../seo/site';
import type { ApiTestimonial } from '../../seo/catalog';
import { Icon } from '../ui/Icon';

interface Props {
  items: ApiTestimonial[];
  lang: Lang;
  /** Enlace «Escribir una reseña» de la ficha de Google (panel → Ajustes). */
  reviewUrl?: string;
}
const { items, lang, reviewUrl = '' } = Astro.props;
const es = lang === 'es';
const text = (t: ApiTestimonial) => (lang === 'en' && t.text_en?.trim()) || t.text;
const stars = (n: number) => Math.max(0, Math.min(5, Math.round(n)));
---
{(items.length > 0 || reviewUrl) && (
  <section class="tst sk-section" id="opiniones" aria-labelledby="tst-title">
    <h2 id="tst-title" class="sk-section-title">
      {items.length > 0
        ? (es ? 'Lo que dicen nuestras alumnas y alumnos' : 'What our members say')
        : (es ? '¿Has venido a clase?' : 'Been to a class?')}
    </h2>
    {items.length > 0 && <ul>
      {items.map((t) => (
        <li>
          <figure>
            {t.rating ? (
              <p class="tst-stars" aria-label={es ? `${stars(t.rating)} de 5` : `${stars(t.rating)} out of 5`}>
                <span aria-hidden="true">{'★'.repeat(stars(t.rating))}{'☆'.repeat(5 - stars(t.rating))}</span>
              </p>
            ) : null}
            <blockquote>{text(t)}</blockquote>
            <figcaption>
              {t.photo_url && <img src={t.photo_url} alt="" width="40" height="40" loading="lazy" decoding="async" />}
              <span><strong>{t.author}</strong>{t.source && <small>{t.source}</small>}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>}
    {reviewUrl && (
      <p class="tst-review">
        <a class="sk-btn" href={reviewUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="google-business" size={16} />
          {es ? 'Déjanos tu opinión en Google' : 'Leave us a Google review'}
        </a>
      </p>
    )}
  </section>
)}

<style>
  /* Acabado con los tokens del estilo visual (styles/presets.css) */
  .tst { max-width: 1100px; margin: 0 auto; padding: 4rem 1.25rem; font-family: var(--font-body); color: var(--page-text); }
  .tst h2 { font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 2.75rem); text-align: center; letter-spacing: .02em; margin: 0 0 2rem; color: var(--heading-color); }
  .tst ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .tst figure { margin: 0; height: 100%; display: flex; flex-direction: column; gap: .75rem; padding: 1.5rem; border-radius: var(--radius-card); background: var(--surface); color: var(--surface-text); border: var(--border-width) solid var(--surface-border); box-shadow: var(--shadow-card); backdrop-filter: var(--surface-blur); -webkit-backdrop-filter: var(--surface-blur); }
  .tst-stars { margin: 0; color: var(--accent); letter-spacing: .1em; }
  .tst blockquote { margin: 0; flex: 1; line-height: 1.7; white-space: pre-line; }
  .tst figcaption { display: flex; align-items: center; gap: .75rem; }
  .tst figcaption img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .tst figcaption span { display: flex; flex-direction: column; }
  .tst small { color: var(--text-muted); }
  .tst-review { margin: 2rem 0 0; text-align: center; }
  .tst-review a { display: inline-flex; align-items: center; gap: .6rem; min-height: 48px; padding: 0 1.5rem; text-decoration: none; font-family: var(--font-body); }
</style>
