---
// Preguntas frecuentes del panel (portada y precios), en HTML de servidor:
// buscadores e IA leen preguntas y respuestas sin ejecutar JavaScript. Acordeón
// accesible con <details>/<summary> (teclado y lectores de pantalla, sin JS).
// El JSON-LD FAQPage lo añade la página (seo/site.ts → faqJsonLd).
import { faqText, type Lang } from '../../seo/site';
import type { ApiFaq } from '../../seo/catalog';

interface Props { faqs: ApiFaq[]; lang: Lang; id?: string }
const { faqs, lang, id = 'faq' } = Astro.props;
const es = lang === 'es';
const items = faqs.map((f) => {
  const { q, a } = faqText(f, lang);
  return { q, paragraphs: a.split(/\n{2,}/) };
});
---
{items.length > 0 && (
  <section class="faq sk-section" id={id} aria-labelledby={`${id}-title`}>
    <h2 id={`${id}-title`} class="sk-section-title">{es ? 'Preguntas frecuentes' : 'Frequently asked questions'}</h2>
    <div class="faq-list">
      {items.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <div class="faq-a">{f.paragraphs.map((p) => <p>{p}</p>)}</div>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  /* Acabado con los tokens del estilo visual (styles/presets.css) */
  .faq { max-width: 760px; margin: 0 auto; padding: 4rem 1.25rem; font-family: var(--font-body); color: var(--page-text); }
  .faq h2 { font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 2.75rem); text-align: center; letter-spacing: .02em; margin: 0 0 1.5rem; color: var(--heading-color); }
  .faq-list { border-radius: var(--radius-card); overflow: hidden; background: var(--surface); border: var(--border-width) solid var(--surface-border); box-shadow: var(--shadow-card); backdrop-filter: var(--surface-blur); -webkit-backdrop-filter: var(--surface-blur); }
  .faq details + details { border-top: 1px solid var(--border-neutral); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 1.25rem; min-height: 56px; font-weight: 700; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; flex-shrink: 0; font-size: 1.4rem; line-height: 1; color: var(--accent); transition: transform .2s ease; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq summary:hover { background: var(--accent-soft); }
  .faq summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .faq-a { padding: 0 1.25rem 1rem; color: var(--text-muted); line-height: 1.7; }
  .faq-a p { margin: 0 0 .6rem; white-space: pre-line; }
</style>
