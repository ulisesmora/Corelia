---
// Portada (ES en / y EN en /en). Se renderiza en servidor en cada petición:
// nombre, colores, logo y textos salen de la config del estudio y el catálogo
// de la API, así que el build no necesita el backend y re-marcar la web no
// requiere redesplegar.
import App from '../App';
import HeroWithVideo from '../VideoComponent';
import Footer from '../Footer';
import SiteHead from '../SiteHead.astro';
import { PhoneUpdateDialogDeferred, PushNotificationsDeferred } from '../Deferred';
import JsonLd from '../seo/JsonLd.astro';
import UpcomingClasses, { pickUpcoming } from './UpcomingClasses';
import HomeSections from './HomeSections.astro';
import LangBoot from '../site/LangBoot.astro';
import { sectionOn } from '../../lib/sections';
import { abs, business, businessJsonLd, faqJsonLd, origin, robotsContent, type Lang } from '../../seo/site';
import {
  getClassTypes, getFaqs, getInstructors, getPlans, getSchedules, getSiteImages,
  getTestimonials, getUpcomingSessions, offeredClasses, studioNow,
} from '../../seo/catalog';
import { getSiteConfig, htmlThemeAttrs, lt } from '../../lib/site';
import { HERO_CSS, HERO_LABELS, heroArtVars, heroView } from '../../lib/hero';
import { dict } from '../../i18n';
import { trStrict } from '../../utils/localized';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';

// Todo el contenido se carga en el servidor, en paralelo y con tolerancia a
// fallos (cada función devuelve null/[] si la API no responde). Las islas de
// React lo reciben como props: el HTML del servidor ya trae clases, equipo,
// salas, precios, FAQs y opiniones (buscadores e IA) y no repiten el fetch.
// Portada corta y fácil de recorrer: hero · próximas clases · lo que
// ofrecemos · precios · estudio y opiniones · dónde estamos. El contenido
// largo vive en su página (clases, precios, /estudio, /contacto) y aquí solo
// hay un resumen con «Ver todo →». Las FAQ siguen en el JSON-LD de la portada.
const [site, classes, schedules, instructors, plans, faqs, testimonials, heroImgs, sessions] = await Promise.all([
  getSiteConfig(), getClassTypes(), getSchedules(), getInstructors(), getPlans(),
  getFaqs('home'), getTestimonials(), getSiteImages('hero'), getUpcomingSessions(),
]);
const now = studioNow();
const upcoming = pickUpcoming(sessions, now, 6);
const offered = offeredClasses(classes, schedules);
const b = business(site);
// Portada (Ajustes → Portada): foto, vídeo de YouTube o ilustración (lib/hero.ts)
const heroImg = heroImgs[0] || null;
const view = heroView(site, heroImg?.image || '');
const art = view.mode === 'illustration';
const heroVars = Object.entries(heroArtVars(view.theme)).map(([k, v]) => `${k}:${v}`).join(';');
const HL = HERO_LABELS[lang];
const headline = (es ? site.tagline : site.tagline_en) || (es ? 'Pilates, Yoga y movimiento' : 'Pilates, Yoga and movement');
// Textos del hero: los del panel (Ajustes → Textos de la web) o los de la foto
// de la portada; la isla React (VideoComponent) calcula lo mismo
const D = (dict[lang] as any).home;
const imgTitle = heroImg
  ? (es ? (heroImg as any).title || '' : trStrict(heroImg, 'title', 'en') || String(D.hero.h1).replace('{studio}', site.studio_name))
  : '';
const imgSubtitle = heroImg && !es ? trStrict(heroImg, 'subtitle', 'en') : '';
const heroTitle = lt(site.content, 'hero_title', lang) || imgTitle;
const heroSubtitle = lt(site.content, 'hero_subtitle', lang) || imgSubtitle;
const PAGE = {
  url: abs(es ? '/' : '/en'),
  title: `${site.studio_name} · ${headline}`,
  description: b.description[lang],
  ogImage: b.ogImage,
};
const jsonLd = [
  businessJsonLd(site, lang, { schedules, instructors, plans }),
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${origin()}/#website`,
    name: site.studio_name,
    url: PAGE.url,
    inLanguage: lang,
    publisher: { '@id': b.id },
  },
  faqJsonLd(faqs, lang),
].filter(Boolean);
const L = es
  ? { book: 'Reservar clase', see: 'Ver horario', next: 'Próximas clases', nextLead: 'Plazas en tiempo real. Reserva en un toque.', all: 'Ver el horario completo' }
  : { book: 'Book a class', see: 'See timetable', next: 'Upcoming classes', nextLead: 'Live availability. Book in one tap.', all: 'See the full timetable' };
const heading = heroTitle || headline;
---

<html lang={lang} {...htmlThemeAttrs(site)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{PAGE.title}</title>
    <meta name="description" content={PAGE.description} />
    <link rel="canonical" href={PAGE.url} />
    <link rel="alternate" hreflang="es" href={abs('/')} />
    <link rel="alternate" hreflang="en" href={abs('/en')} />
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    <meta name="robots" content={robotsContent(site)} />
    <SiteHead />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.studio_name} />
    <meta property="og:locale" content={es ? 'es_ES' : 'en_GB'} />
    <meta property="og:title" content={PAGE.title} />
    <meta property="og:description" content={PAGE.description} />
    <meta property="og:url" content={PAGE.url} />
    <meta property="og:image" content={PAGE.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={PAGE.title} />
    <meta name="twitter:description" content={PAGE.description} />
    <meta name="twitter:image" content={PAGE.ogImage} />

    <!-- PERF: resource hints — el browser empieza a abrir conexiones en paralelo
         con el HTML, ahorrando 100-300ms de RTT en móvil 4G/5G. -->
    <link rel="preconnect" href="https://js.stripe.com" crossorigin>
    <link rel="dns-prefetch" href="https://js.stripe.com">
    {view.preload && <link rel="preload" as="image" href={view.preload} fetchpriority="high" />}

    {/* Hero: CSS común de la réplica del servidor y de la isla React (lib/hero.ts).
        La réplica se ve al instante y es lo que mide Google como carga principal (LCP). */}
    <style is:inline set:html={HERO_CSS} />
    {jsonLd.map((d) => <JsonLd data={d} />)}

    <!-- PERF móvil — bloque CSS crítico inline. Apaga backdrop-filter en iPhone
         y respeta reduced-motion. Aplica ANTES del primer paint, sin esperar
         a que React hidrate ni a que llegue el CSS bundle. -->
    <style is:inline>{`
      @media (hover: none) and (pointer: coarse), (max-width: 900px) {
        * {
          backdrop-filter: none !important;
          -webkit-backdrop-filter: none !important;
          will-change: auto !important;
        }
        /* Solo estilo "glass": un bg rgba blanco translúcido escrito a mano
           obtiene un gradiente más opaco para preservar el efecto "card
           flotante" sin backdrop-filter. Los demás estilos usan tokens. */
        :root[data-style="glass"] [style*="rgba(255,255,255,0.5"],
        :root[data-style="glass"] [style*="rgba(255,255,255,0.6"],
        :root[data-style="glass"] [style*="rgba(255,255,255,0.7"],
        :root[data-style="glass"] [style*="rgba(255, 255, 255, 0.5"],
        :root[data-style="glass"] [style*="rgba(255, 255, 255, 0.6"],
        :root[data-style="glass"] [style*="rgba(255, 255, 255, 0.7"] {
          background: linear-gradient(135deg, rgba(255,255,255,0.92) 0%, color-mix(in srgb, var(--brand-bg) 85%, transparent) 100%) !important;
        }
        /* Versión más sutil para overlays oscuros sobre video/imagen */
        :root[data-style="glass"] [style*="rgba(255,255,255,0.1"],
        :root[data-style="glass"] [style*="rgba(255,255,255,0.2"],
        :root[data-style="glass"] [style*="rgba(255,255,255,0.3"],
        :root[data-style="glass"] [style*="rgba(255, 255, 255, 0.1"],
        :root[data-style="glass"] [style*="rgba(255, 255, 255, 0.2"],
        :root[data-style="glass"] [style*="rgba(255, 255, 255, 0.3"] {
          background: linear-gradient(135deg, rgba(255,255,255,0.35) 0%, rgba(255,255,255,0.18) 100%) !important;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
      .lazy-section {
        content-visibility: auto;
        contain-intrinsic-size: 0 600px;
      }
    `}</style>

    {/* Idioma de la página para las islas de React (sin parpadeo) */}
    <LangBoot lang={lang} />
  </head>

  <body class="format">
    <App client:only="react" />
    <main id="contenido">
      <HeroWithVideo client:only="react" heroImage={heroImg}>
        <section slot="fallback" class={`hero hero--${art ? 'art' : view.mode}`} style={heroVars || undefined}>
          <div class="hero-in">
            <div class="hero-content">
              <h1 class="hero-title">{heading}</h1>
              {heroSubtitle && <p class="hero-sub">{heroSubtitle}</p>}
              <div class="hero-row">
                <a class="hero-cta sk-btn" href="/calendar">{L.book}</a>
                <a class="hero-ghost sk-btn-ghost" href="#proximas">{L.see}</a>
              </div>
            </div>
            {art
              ? <div class="hero-art" aria-hidden="true" set:html={view.art} />
              : (
                <div class="hero-media" style={`background:${view.background}`}>
                  {/* Vídeo: antes de hidratar, póster y botón (nada se pide a YouTube) */}
                  {view.mode === 'video' && (
                    <button type="button" class="hero-play"><span aria-hidden="true">▶</span> {HL.play} <small>· {HL.playHint}</small></button>
                  )}
                </div>
              )}
          </div>
        </section>
      </HeroWithVideo>

      {sectionOn(site, 'next') && <section class="w-sec w-sec--tight" id="proximas" aria-labelledby="next-title">
        <div class="w-wrap">
          <div class="w-head">
            <div>
              <h2 class="w-h2" id="next-title">{L.next}</h2>
              <p class="w-lead">{L.nextLead}</p>
            </div>
            <a class="w-more" href="/calendar">{L.all} <span aria-hidden="true">→</span></a>
          </div>
          <UpcomingClasses client:visible={{ rootMargin: '400px' }} lang={lang} initial={upcoming} now={now} />
        </div>
      </section>}

      {/* Cada sección respeta el interruptor del panel y se oculta si no tiene contenido */}
      {sectionOn(site, 'classes') && <HomeSections kind="offer" lang={lang} site={site} offered={offered} />}
      {sectionOn(site, 'prices') && <HomeSections kind="prices" lang={lang} site={site} plans={plans} />}
      {(sectionOn(site, 'team') || sectionOn(site, 'testimonials')) && (
        <HomeSections kind="trust" lang={lang} site={site}
          instructors={sectionOn(site, 'team') ? instructors || [] : []}
          testimonials={sectionOn(site, 'testimonials') ? testimonials : []} />
      )}
      {sectionOn(site, 'location') && <HomeSections kind="visit" lang={lang} site={site} schedules={schedules} />}
    </main>

    <Footer client:visible={{ rootMargin: "600px" }} lang={lang} />
    <PhoneUpdateDialogDeferred client:idle />
    <PushNotificationsDeferred client:idle />
  </body>
</html>
