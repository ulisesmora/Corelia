---
import ResetPasswordPage from '../components/RecoverPassword';
import Footer from '../components/Footer';
import AppFixed from './../components/AppFixed';
import OptimizedHead from '../components/OptimizedHead.astro';
---

<html lang="es">
  <head>
    <!-- noAnalytics: la URL lleva el token de recuperación; no debe llegar a Clarity -->
    <OptimizedHead title="Nueva contraseña" titleEn="New password" noAnalytics noindex />
    <!-- Que el token de la URL no viaje en la cabecera Referer a terceros -->
    <meta name="referrer" content="no-referrer" />
  </head>
  <body class="format" style="background:color-mix(in srgb, var(--brand-bg) 55%, white)">
    <AppFixed client:only="react" />

    <main id="contenido">
      <ResetPasswordPage client:only="react" />
    </main>

    <Footer client:only="react" />
  </body>
</html>
