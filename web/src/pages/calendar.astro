---
import Footer from '../components/Footer';
import AppFixed from '../components/AppFixed';
import CalendarViewPage from '../components/CalendarSection';
import OptimizedHead from '../components/OptimizedHead.astro';
import { getSiteConfig, htmlThemeAttrs } from '../lib/site';
const site = await getSiteConfig();
---

<html lang="es" {...htmlThemeAttrs(site)}>
  <head>
    <OptimizedHead
      title="Horario de clases"
      titleEn="Class timetable"
      description="Horario semanal de clases: mira las plazas libres y reserva online en un momento."
      canonicalPath="/calendar"
    />
  </head>
  <body class="format">
        <AppFixed client:only="react" />

    <main id="contenido" class="w-main-app">
      <CalendarViewPage client:only="react" />
    </main>

    <Footer client:only="react" />
  </body>
</html>
