---
import Footer from '../components/Footer';
import AppFixed from '../components/AppFixed';
import UpdatePreferencesForm from '../components/UpdatePreferencesForm';
import OptimizedHead from '../components/OptimizedHead.astro';
import { getSiteConfig, htmlThemeAttrs } from '../lib/site';
const site = await getSiteConfig();
---

<html lang="es" {...htmlThemeAttrs(site)}>
  <head>
    <OptimizedHead title="Actualizar preferencias" titleEn="Update preferences" noindex />
  </head>
  <body class="format">
    <AppFixed client:only="react" />

    <main id="contenido" style="">
      <UpdatePreferencesForm client:only="react"/>
    </main>

    <Footer client:only="react" />
  </body>
</html>
