---
import Footer from '../components/Footer';
import AppFixed from '../components/AppFixed';
import CheckoutPage from '../components/CheckoutPage';
import PageLoader from '../components/PageLoader.astro';
import OptimizedHead from '../components/OptimizedHead.astro';
import { getSiteConfig, htmlThemeAttrs } from '../lib/site';
const site = await getSiteConfig();
---

<html lang="es" {...htmlThemeAttrs(site)}>
  <head>
    <OptimizedHead title="Finalizar reserva" titleEn="Checkout" noindex />
  </head>
  <body class="format">
    <PageLoader minMs={300} maxMs={4000} />
    <AppFixed client:only="react" />

    <main id="contenido" class="w-main-app">
      <CheckoutPage client:only="react"/>
    </main>

    <Footer client:only="react" />
  </body>
</html>
