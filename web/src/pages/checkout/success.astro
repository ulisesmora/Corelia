---
import Footer from '../../components/Footer';
import AppFixed from '../../components/AppFixed';
import CheckoutSuccessPage from '../../components/PaymentFinish';
import OptimizedHead from '../../components/OptimizedHead.astro';
---

<html lang="es">
  <head>
    <!-- noAnalytics: la URL lleva el id de la sesión de pago -->
    <OptimizedHead title="Pago" titleEn="Payment" noindex noAnalytics />
  </head>
  <body class="format">
    <AppFixed client:only="react" />

    <main id="contenido" style="">
      <CheckoutSuccessPage client:only="react"/>
    </main>

    <Footer client:only="react" />
  </body>
</html>
